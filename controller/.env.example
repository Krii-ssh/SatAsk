# Copy to controller/.env. server.py and e2e.py read it on start-up.
# With nothing set, every tool is mocked and the planner is keyword-only and offline.

# --- Model services -------------------------------------------------------
# Mocks are on by default. Turn them off one tool at a time as real services come up.
SATASK_MOCK=1
# SATASK_MOCK_VQA=0
# SATASK_VQA_URL=http://127.0.0.1:8001/vqa
# SATASK_MOCK_GROUND=0
# SATASK_GROUND_URL=http://127.0.0.1:8002/ground
# SATASK_MOCK_CHANGE_DETECT=0
# SATASK_CHANGE_DETECT_URL=http://127.0.0.1:8003/change_detect
# SATASK_MOCK_CROSS_MODAL=0
# SATASK_CROSS_MODAL_URL=http://127.0.0.1:8004/cross_modal

# --- Planner LLM (any OpenAI-compatible endpoint) -------------------------
# Primary: Ollama by default. Setting any of these three enables it.
# SATASK_LLM_BASE_URL=http://localhost:11434/v1
# SATASK_LLM_MODEL=gpt-oss:20b
# SATASK_LLM_API_KEY=

# Fallback: Gemini's OpenAI-compatible endpoint by default. Setting the key enables it.
# SATASK_LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SATASK_LLM_FALLBACK_MODEL=gemini-3.6-flash
# SATASK_LLM_FALLBACK_API_KEY=

# --- HTTP server ----------------------------------------------------------
# SATASK_CONTROLLER_PORT=8080
